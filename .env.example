# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Authentication Secret (REQUIRED - generate a secure random string)
AUTH_SECRET=change-this-to-a-long-random-secure-string

# Admin Credentials (optional overrides for seeded admin)
# SEED_ADMIN_EMAIL=admin@company.com
# SEED_ADMIN_PASSWORD=Admin@123

# ========================================
# WhatsApp Cloud API Configuration
# ========================================
# Get these from Meta Business Manager → WhatsApp → API Setup
# https://business.facebook.com/

# Enable/disable WhatsApp features (true/false)
WHATSAPP_ENABLED=true

# WhatsApp Business Account Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Permanent Access Token (keep this secret!)
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token

# WhatsApp Cloud API version (default: v21.0)
WHATSAPP_API_VERSION=v21.0

# Default country code for phone normalization (India: 91)
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Request timeout in milliseconds
WHATSAPP_REQUEST_TIMEOUT_MS=8000

# ========================================
# WhatsApp OTP Authentication
# ========================================
# Template name for customer OTP (must be approved by Meta)
WHATSAPP_OTP_TEMPLATE=customer_auth_otp

# Template language code
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US

# OTP expiry time in minutes
WHATSAPP_OTP_EXPIRY_MINUTES=10

# Maximum verification attempts per OTP
WHATSAPP_OTP_MAX_ATTEMPTS=3

# Maximum OTP resend requests per 24 hours
WHATSAPP_OTP_MAX_RESENDS_PER_DAY=3

# Customer Registration Confirmation Code (required for new registrations)
# This prevents unauthorized signups - only users with this code can register
CUSTOMER_REGISTRATION_CODE=ETPL@2026

# ========================================
# WhatsApp Invoice Template
# ========================================
# Template name for invoice PDF sharing (must be approved by Meta)
WHATSAPP_INVOICE_TEMPLATE=pos_invoice

# Template language for invoices
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# ========================================
# E-Invoice Configuration
# ========================================
EINVOICE_MODE=mock
EINVOICE_BASE_URL=https://einv-apisandbox.nic.in
EINVOICE_CLIENT_ID=your_client_id
EINVOICE_CLIENT_SECRET=your_client_secret
EINVOICE_USERNAME=your_api_username
EINVOICE_PASSWORD=your_api_password
EINVOICE_GSTIN=your_gstin
EINVOICE_PUBLIC_KEY=your_nic_public_key
